
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>

<body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
        <h1><%= blog.title %></h1>

        <img src="<%= blog.coverImage %>" width="600px" alt="Blog cover">

        <pre class="mt-3"><%= blog.body %></pre>

        <!-- Blog Author -->
        <div class="container mt-4">
            <img
                src="<%= blog.createdBy.profileImage %>"
                width="60"
                alt="Author profile"
            >
            <%= blog.createdBy.fullName %>
        </div>

        <!-- Comments Section -->
        <div class="container mt-3">
          
<h3>Comments (<%= comments.length %>)</h3>

<% if (user) { %>
    <p>Logged in as: <%= user.fullName %></p>

    <form action="/blog/comment/<%= blog._id %>" method="POST">
        <textarea
            name="content"
            placeholder="Write your comment..."
            required
        ></textarea>

        <button type="submit">Add Comment</button>
    </form>
<% } else { %>
    <a href="/user/signin">Sign in to add a comment</a>
<% } %>



            <!-- Display Comments -->
            <div class="mt-4">
                <% comments.forEach(comment => { %>
                    <div class="container mt-4">

                        <img
                            src="<%= comment.createdBy.profileImage %>"
                            width="60"
                            alt="Comment author profile"
                        >

                        <%= comment.createdBy.fullName %>

                        <pre><%= comment.content %></pre>

                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <%- include('./partials/script') %>
</body>

</html>
