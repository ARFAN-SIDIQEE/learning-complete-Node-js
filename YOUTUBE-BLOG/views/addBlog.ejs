<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>add new Blog</title>
  </head>

  <body>
    <%- include('./partials/nav') %>
    <div class="containner mt-3">
      <form action="/blog" method="post" enctype="multipart/form-data">
            <div class="mb-3">
          <label for="coverImage" class="form-lable">Cover Image</label>
          <input
            type="file"
            class="form-control"
            id="coverImage"
            name="coverImage"
            aria-describedby="coverImage"
          />

        <div class="mb-3">
          <label for="title" class="form-lable">Title</label>
          <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            aria-describedby="title"
          />
        </div>

        <div class="mb-3">
          <label for="body" class="form-label"
            >body</label
          >
          <textarea
             name="body"
            class="form-control"
            id="body"
            rows="3"
          ></textarea>
        </div>
         <div class="mb-3">
          <button class="btn btn-primary"> submit</button>
        </div>
      </form>
    </div>
    <%- include('./partials/script') %>
  </body>
</html>
